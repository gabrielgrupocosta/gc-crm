rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function organizacaoId() {
      return request.auth.token.organizacaoId;
    }

    function isSuperAdmin() {
      return autenticado() && role() == 'master';
    }

    function isAdminOrg() {
      return autenticado() && role() == 'admin_org';
    }

    function isGestor() {
      return autenticado() && role() == 'gestor';
    }

    function isSupervisor() {
      return autenticado() && role() == 'supervisor';
    }

    // Supervisor tem escopo de dados igual admin_org (organização inteira),
    // mas só nas coleções cujo menu foi liberado no custom claim. curto-circuita
    // em isSupervisor() primeiro pra não quebrar em tokens de outros roles que
    // não têm o campo menuPermissions.
    function temMenu(chave) {
      return isSupervisor() && (chave in request.auth.token.menuPermissions);
    }

    function mesmaOrg(dados) {
      return autenticado() && organizacaoId() == dados.organizacaoId;
    }

    // Dupla política de escrita para tabelas críticas (financeiro/contratual/
    // sensível): confere a organização do documento ANTES (dadosAntigos,
    // equivalente a USING) e DEPOIS (dadosNovos, equivalente a WITH CHECK) da
    // escrita, e garante que organizacaoId é imutável — sem isso, admin_org
    // poderia "sequestrar" um contrato/cobrança/resultado trocando o campo
    // organizacaoId para fora da própria organização.
    function escritaSeguraOrg(dadosAntigos, dadosNovos) {
      return mesmaOrg(dadosAntigos) && mesmaOrg(dadosNovos)
        && dadosNovos.organizacaoId == dadosAntigos.organizacaoId;
    }

    // Rate limit de criação nas coleções críticas (clientes/contratos/lojas):
    // o front cria o documento numa transação que também incrementa
    // rate_limits/{uid}_{colecao} — getAfter() lê o valor desse contador já
    // considerando os writes pendentes da MESMA transação, então não dá pra
    // criar o documento sem que o contador tenha sido corretamente atualizado
    // junto (client não consegue "pular" o incremento).
    function limiteCriacaoPorHora() {
      return 40;
    }

    function rateLimitOk(colecao) {
      let rl = getAfter(/databases/$(database)/documents/rate_limits/$(request.auth.uid + '_' + colecao)).data;
      return rl.contagem <= limiteCriacaoPorHora();
    }

    // Companion doc do rate limit — só o próprio usuário lê/escreve o seu, e a
    // escrita só é aceita se a contagem for matematicamente consistente (reset
    // de janela com contagem=1, ou incremento de exatamente +1 dentro da hora).
    match /rate_limits/{rlId} {
      allow read: if autenticado() && rlId.split('_')[0] == request.auth.uid;
      allow create: if autenticado() && rlId.split('_')[0] == request.auth.uid
        && request.resource.data.contagem == 1
        && request.resource.data.inicio == request.time;
      allow update: if autenticado() && rlId.split('_')[0] == request.auth.uid
        && (
          (request.time.toMillis() - resource.data.inicio.toMillis() > 3600000
            && request.resource.data.contagem == 1
            && request.resource.data.inicio == request.time)
          ||
          (request.time.toMillis() - resource.data.inicio.toMillis() <= 3600000
            && request.resource.data.contagem == resource.data.contagem + 1
            && request.resource.data.inicio == resource.data.inicio)
        );
      allow delete: if false;
    }

    // master: acesso total à plataforma. admin_org só pode ler a
    // própria organização (ex: exibir nome dela no formulário de loja) —
    // nunca listar ou ler outras, e nunca escrever.
    match /organizacoes/{orgId} {
      allow read: if isSuperAdmin() || (isAdminOrg() && orgId == organizacaoId());
      allow write: if isSuperAdmin();
    }

    // Faturas: dado financeiro da plataforma (cobrança da própria organização
    // pelo uso do sistema) — só master acessa. Update com dupla política:
    // organizacaoId da fatura não pode ser trocado numa edição.
    match /faturas/{faturaId} {
      allow read, create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && resource.data.organizacaoId == request.resource.data.organizacaoId;
    }

    match /configuracoes/{docId} {
      allow read: if autenticado();
      allow write: if isSuperAdmin();
    }

    // Coleções escopadas por organização — admin_org e gestor só acessam
    // documentos da própria organizacaoId; master acessa tudo.
    match /users/{userId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data))
        || (temMenu('gestores') && mesmaOrg(request.resource.data) && request.resource.data.role == 'gestor');
      allow update, delete: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(resource.data))
        || (temMenu('gestores') && mesmaOrg(resource.data) && resource.data.role == 'gestor'
            && (!('role' in request.resource.data) || request.resource.data.role == 'gestor'));
    }

    // Clientes: contém mensalidade (dado financeiro). Update exige dupla
    // política — organizacaoId não pode ser alterado na edição.
    match /clientes/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data) && rateLimitOk('clientes'))
        || (temMenu('clientes') && mesmaOrg(request.resource.data) && rateLimitOk('clientes'));
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (temMenu('clientes') && escritaSeguraOrg(resource.data, request.resource.data));
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    // Contratos: dado financeiro/contratual do cliente — só master e admin_org
    // da própria organização (gestor não acessa, mesma exclusividade de Clientes).
    // Update exige dupla política — organizacaoId não pode ser alterado.
    match /contratos/{docId} {
      allow read: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data)) || (temMenu('contratos') && mesmaOrg(resource.data));
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data) && rateLimitOk('contratos'))
        || (temMenu('contratos') && mesmaOrg(request.resource.data) && rateLimitOk('contratos'));
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (temMenu('contratos') && escritaSeguraOrg(resource.data, request.resource.data));
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    // Cobranças (Financeiro/recebíveis): mesma exclusividade de Contratos —
    // dado financeiro do cliente, só master e admin_org da própria organização.
    // Update exige dupla política — organizacaoId não pode ser alterado.
    match /cobrancas/{docId} {
      allow read: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data)) || (temMenu('financeiro') && mesmaOrg(resource.data));
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data))
        || (temMenu('financeiro') && mesmaOrg(request.resource.data));
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (temMenu('financeiro') && escritaSeguraOrg(resource.data, request.resource.data));
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    // Lojas: gestorId é o campo que determina acesso (regra crítica do
    // sistema) — update exige dupla política para impedir que organizacaoId
    // seja trocado numa edição, e o gestor só pode alterar o próprio
    // status/observações, nunca reatribuir a loja a outro gestorId.
    match /lojas/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data) && rateLimitOk('lojas'))
        || (temMenu('lojas') && mesmaOrg(request.resource.data) && rateLimitOk('lojas'));
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (temMenu('lojas') && escritaSeguraOrg(resource.data, request.resource.data))
        || (isGestor() && escritaSeguraOrg(resource.data, request.resource.data)
            && resource.data.gestorId == request.auth.uid
            && request.resource.data.gestorId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    // Resultados: contém faturamento (dado financeiro). Update exige dupla
    // política — organizacaoId não pode ser alterado na edição, e o gestor
    // só edita resultado que continua sendo dele antes e depois da escrita.
    match /resultados/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data))
        || (isSupervisor() && mesmaOrg(request.resource.data))
        || (isGestor() && mesmaOrg(request.resource.data) && request.resource.data.gestorId == request.auth.uid);
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (isSupervisor() && escritaSeguraOrg(resource.data, request.resource.data))
        || (isGestor() && escritaSeguraOrg(resource.data, request.resource.data)
            && resource.data.gestorId == request.auth.uid
            && request.resource.data.gestorId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    // Checkpoints de lojas novas (acompanhamento dos primeiros 30 dias/4
    // semanas de gestão, independente de resultados/dashboard) — mesma regra
    // de escopo de Resultados: gestor só cria/edita checkpoint de loja onde é
    // o gestorId responsável. Supervisor entra igual admin_org (visão da org
    // inteira, sem gestorId pessoal) — sem isso, a seção "Lojas Novas" dentro
    // do Relatório Semanal (visível pra supervisor) travava com
    // permission-denied ao tentar salvar um checkpoint.
    match /checkpoints_lojas_novas/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(request.resource.data))
        || (isSupervisor() && mesmaOrg(request.resource.data))
        || (isGestor() && mesmaOrg(request.resource.data) && request.resource.data.gestorId == request.auth.uid);
      allow update: if isSuperAdmin()
        || (isAdminOrg() && escritaSeguraOrg(resource.data, request.resource.data))
        || (isSupervisor() && escritaSeguraOrg(resource.data, request.resource.data))
        || (isGestor() && escritaSeguraOrg(resource.data, request.resource.data)
            && resource.data.gestorId == request.auth.uid
            && request.resource.data.gestorId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    match /relatorios/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin() || (autenticado() && mesmaOrg(request.resource.data));
      allow update, delete: if isSuperAdmin() || (autenticado() && mesmaOrg(resource.data));
    }

    match /relatorios_semanais/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin() || (autenticado() && mesmaOrg(request.resource.data));
      allow update, delete: if isSuperAdmin() || (autenticado() && mesmaOrg(resource.data));
    }

    match /feedbacks/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if autenticado() && mesmaOrg(request.resource.data);
      allow update, delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));
    }

    match /tarefas/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin() || (autenticado() && mesmaOrg(request.resource.data));
      allow update, delete: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(resource.data))
        || (isGestor() && mesmaOrg(resource.data) && resource.data.gestorId == request.auth.uid);
    }

    match /acoes/{docId} {
      allow read: if isSuperAdmin() || mesmaOrg(resource.data);
      allow create: if isSuperAdmin() || (autenticado() && mesmaOrg(request.resource.data));
      allow update, delete: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(resource.data))
        || (isGestor() && mesmaOrg(resource.data) && resource.data.gestorId == request.auth.uid);
    }

    // Modelos de ação: catálogo pessoal de cada gestor (ou admin_org) —
    // só o dono lê/gerencia os próprios modelos.
    match /acao_modelos/{docId} {
      allow read: if isSuperAdmin() || (mesmaOrg(resource.data) && resource.data.gestorId == request.auth.uid);
      allow create: if isSuperAdmin() || (autenticado() && mesmaOrg(request.resource.data) && request.resource.data.gestorId == request.auth.uid);
      allow update, delete: if isSuperAdmin() || (mesmaOrg(resource.data) && resource.data.gestorId == request.auth.uid);
    }

    // CRM de prospecção: admin_org vê/gerencia todos os leads da própria
    // organização; gestor só os leads onde é o responsável.
    // Conversas de WhatsApp: painel de atendimento, acesso restrito a master
    // (mesma exclusividade das demais telas de plataforma).
    match /conversas_whatsapp/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /crm_leads/{leadId} {
      allow read: if isSuperAdmin()
        || (mesmaOrg(resource.data) && (isAdminOrg() || resource.data.responsavelId == request.auth.uid));
      allow create: if isSuperAdmin()
        || (mesmaOrg(request.resource.data) && (isAdminOrg() || request.resource.data.responsavelId == request.auth.uid));
      allow update: if isSuperAdmin()
        || (isAdminOrg() && mesmaOrg(resource.data))
        || (isGestor() && mesmaOrg(resource.data) && resource.data.responsavelId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAdminOrg() && mesmaOrg(resource.data));

      // Histórico de interações — visibilidade herda do lead pai (mesma
      // organização + mesmo dono do negócio), mas só admin_org/master
      // corrigem ou apagam um registro já lançado (mantém trilha de auditoria).
      match /interacoes/{interacaoId} {
        function leadPai() { return get(/databases/$(database)/documents/crm_leads/$(leadId)).data; }
        allow read: if isSuperAdmin()
          || (autenticado() && organizacaoId() == leadPai().organizacaoId && (isAdminOrg() || leadPai().responsavelId == request.auth.uid));
        allow create: if isSuperAdmin()
          || (autenticado() && organizacaoId() == leadPai().organizacaoId && (isAdminOrg() || leadPai().responsavelId == request.auth.uid));
        allow update, delete: if isSuperAdmin() || (isAdminOrg() && organizacaoId() == leadPai().organizacaoId);
      }
    }
  }
}
